# =============================================================================
# Configuration de développement de Jarvis (utilisée par le .venv / la console).
#
# L'application distribuée n'utilise PAS ce fichier : elle lit/write
# %LOCALAPPDATA%\Jarvis\config\config.json (créé par l'assistant de premier
# lancement). Ces variables restent utiles pour itérer en développement.
# =============================================================================

# Nom de l'utilisateur affiché par Jarvis (obligatoire en dev).
JARVIS_USER=Prénom

# Clé API Gemini (obligatoire). Ne jamais committer une vraie clé.
GEMINI_API_KEY=

# Modèle Gemini Live (valeur par défaut recommandée).
GEMINI_MODEL=gemini-2.5-flash-native-audio-preview-12-2025

# Mémoire persistante
JARVIS_MEMORY_ENABLED=1
JARVIS_MEMORY_MAX_RESULTS=5
JARVIS_MEMORY_MIN_IMPORTANCE=1

# Routines / rappels / modes
JARVIS_ROUTINES_ENABLED=1
JARVIS_REMINDERS_ENABLED=1
JARVIS_MODES_ENABLED=1

# Chemin du dossier de données (facultatif ; par défaut ~/.jarvis ou
# %LOCALAPPDATA%\Jarvis).
#JARVIS_DATA_DIR=

# =============================================================================
# Deezer (v1.5.2) — OAuth optionnel ; les playlists locales n'en ont pas besoin
# =============================================================================
# Le catalogue public (recherche artistes/albums/morceaux/playlists, ouverture
# de contenus) fonctionne SANS authentification.
#
# Les playlists personnelles et le profil nécessitent un access_token Deezer.
# Depuis 2025 Deezer a restreint la création de nouvelles apps API pour les
# particuliers : si vous disposez déjà d'un token valide, renseignez-le ici.
# Ne committez JAMAIS un vrai token. Il est aussi stockable dans
# %LOCALAPPDATA%\Jarvis\deezer_auth.json (créé à la connexion).
#DEEZER_ACCESS_TOKEN=
# Alias accepté :
#JARVIS_DEEZER_TOKEN=

# Application ID / secret (uniquement si vous avez une app Deezer développeur
# existante — non requis pour le catalogue public).
#DEEZER_APP_ID=
#DEEZER_APP_SECRET=

# =============================================================================
# Tâches d'arrière-plan v1.8 (identifiants surchargeables)
# =============================================================================
# Modèle Live découvert automatiquement via models.list + validation Bidi.
# Hint facultatif, jamais utilisé sans validation réelle :
#JARVIS_TASK_LIVE_MODEL=
JARVIS_TASK_COMPLEX_MODEL=gemini-3.8-flash
JARVIS_TASK_MAX_CONCURRENT=3
JARVIS_TASK_COMPLEX_CONCURRENCY=1
JARVIS_TASK_COMPLEX_RPM=5
JARVIS_TASK_COMPLEX_RPD=20
JARVIS_TASK_COMPLEX_TPM=250000
JARVIS_TASK_TIMEOUT=90
JARVIS_TASK_TOTAL_TIMEOUT=240
JARVIS_TASK_RETRY_ATTEMPTS=3
JARVIS_TASK_RETRY_BASE_DELAY=1
