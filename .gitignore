# Environnement / secrets
.env
.venv/
__pycache__/
*.py[cod]

# État et logs de l'UI (régénérés à l'exécution)
UI/appearance_state.json
UI/system_state.json
UI/menu_state.json
UI/jarvis_debug.log

# Données locales persistantes (mémoire SQLite, caches utilisateur)
data/
*.db
*.db-shm
*.db-wal

# Routines, rappels et modes locaux (hors du depot par defaut : ~/.jarvis)
routines.json
schedule.db
mode.json

# Modèles OpenWakeWord téléchargés lors du build (binaires volumineux)
resources/openwakeword/
resources/models/

# Builds & artefacts de packaging
dist/
build/
*.spec.bak
*.zip
*.sha256
*.exe

# Outils
.idea/
.vscode/
*.log
